ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:5173
# Optional alternate host ports when another project uses 5173 or 8000.
# Compose derives its allowed localhost origin from PROOFLANE_WEB_PORT.
PROOFLANE_WEB_PORT=5173
PROOFLANE_API_PORT=8000
COOKIE_SECURE=false
POSTGRES_PASSWORD=GENERATE_DB_PASSWORD
# Host development ports; the full Compose stack uses private service endpoints.
DATABASE_URL=postgresql+psycopg://prooflane:GENERATE_DB_PASSWORD@localhost:15432/prooflane
# Host development with docker-compose.dev.yml; Compose uses redis:6379 internally.
REDIS_URL=redis://localhost:16379/0
STORAGE_BACKEND=s3
LOCAL_STORAGE=.runtime/objects
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=dev-fixture-files
S3_ACCESS_KEY=GENERATE_STORAGE_USER
S3_SECRET_KEY=GENERATE_STORAGE_PASSWORD
AWS_REGION=us-east-1
KMS_KEY_ID=
S3_BUCKET_KEY_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=13310
SCANNER_TIMEOUT=60
MAX_UPLOAD_BYTES=26214400
EVIDENCE_TTL=3600
WORKER_CAPACITY=2
TENANT_CAPACITY=2
MAX_ATTEMPTS=3
LEASE_SECONDS=180
STARVATION_SECONDS=120
SCHEDULER_FALLBACK=edf
MODEL_DIRECTORY=artifacts/models
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Authentication uses opaque server-side sessions, not JWT signing keys.
# Production: HTTPS origin, COOKIE_SECURE=true, private S3 + KMS + IAM role.
# Optional cloud injection: secrets arrive through ECS Secrets Manager references.
DATABASE_HOST=
DATABASE_USER=prooflane
DATABASE_NAME=prooflane
DATABASE_PASSWORD=
DATABASE_SSLMODE=verify-full
DATABASE_SSLROOTCERT=
REDIS_HOST=
REDIS_PASSWORD=
STORAGE_EVENT_QUEUE_URL=
RESEARCH_RESULTS_PATH=artifacts/results-v2/results.json
