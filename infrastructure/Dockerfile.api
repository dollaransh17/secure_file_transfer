FROM python:3.12-slim
WORKDIR /app
ADD https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /etc/ssl/certs/aws-rds-global.pem
COPY pyproject.toml .
COPY apps/api apps/api
RUN pip install --no-cache-dir '.[test]'
COPY . .
ENV PYTHONPATH=/app/apps/api:/app
CMD ["uvicorn","prooflane.main:app","--host","0.0.0.0","--port","8000"]
