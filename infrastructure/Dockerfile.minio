# syntax=docker/dockerfile:1
# Build the existing research version from its official, immutable source commit.
# This avoids discontinued minio/minio and minio/mc registry distributions.
FROM golang:1.24-alpine AS builder
RUN apk add --no-cache ca-certificates git
WORKDIR /src
RUN git clone --depth 1 --branch RELEASE.2025-04-22T22-12-26Z https://github.com/minio/minio.git . \
    && test "$(git rev-parse HEAD)" = "0d7408fc9969caf07de6a8c3a84f9fbb10a6739e"
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -p 2 -trimpath -tags kqueue \
    -ldflags "$(go run buildscripts/gen-ldflags.go)" -o /out/minio .
FROM alpine:3.21
RUN apk add --no-cache ca-certificates curl \
    && addgroup -g 1000 minio && adduser -D -u 1000 -G minio minio \
    && mkdir /data && chown minio:minio /data
COPY --from=builder /out/minio /usr/local/bin/minio
COPY --from=builder /src/LICENSE /licenses/minio/LICENSE
USER minio
EXPOSE 9000 9001
VOLUME /data
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
