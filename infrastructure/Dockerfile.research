FROM python:3.12-slim
WORKDIR /app
ADD https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /etc/ssl/certs/aws-rds-global.pem
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
# Select the official CPU distribution explicitly, including native ARM64 wheels.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu 'torch>=2.6,<3'
COPY pyproject.toml .
COPY apps/api apps/api
RUN pip install --no-cache-dir '.[test,research]' && pip check
COPY . .
ENV PYTHONPATH=/app/apps/api:/app \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1
RUN python -c "import torch, torch_geometric, lightgbm; print('torch', torch.__version__, 'PyG', torch_geometric.__version__, 'LightGBM', lightgbm.__version__)"
CMD ["python", "-m", "pytest", "tests/test_models.py", "-q", "-rs"]
