{"AWSTemplateFormatVersion":"2010-09-09","Description":"Prooflane ECR image repositories; review before creating AWS resources.","Parameters":{"ProjectName":{"Type":"String","Default":"prooflane","AllowedPattern":"[a-z][a-z0-9-]{2,23}"}},"Resources":{"ApiRepository":{"Type":"AWS::ECR::Repository","DeletionPolicy":"Retain","UpdateReplacePolicy":"Retain","Properties":{"RepositoryName":{"Fn::Sub":"${ProjectName}/api"},"ImageTagMutability":"IMMUTABLE","ImageScanningConfiguration":{"ScanOnPush":true},"EncryptionConfiguration":{"EncryptionType":"AES256"}}},"WebRepository":{"Type":"AWS::ECR::Repository","DeletionPolicy":"Retain","UpdateReplacePolicy":"Retain","Properties":{"RepositoryName":{"Fn::Sub":"${ProjectName}/web"},"ImageTagMutability":"IMMUTABLE","ImageScanningConfiguration":{"ScanOnPush":true},"EncryptionConfiguration":{"EncryptionType":"AES256"}}},"ResearchRepository":{"Type":"AWS::ECR::Repository","DeletionPolicy":"Retain","UpdateReplacePolicy":"Retain","Properties":{"RepositoryName":{"Fn::Sub":"${ProjectName}/research"},"ImageTagMutability":"IMMUTABLE","ImageScanningConfiguration":{"ScanOnPush":true},"EncryptionConfiguration":{"EncryptionType":"AES256"}}}},"Outputs":{"ApiUri":{"Value":{"Fn::GetAtt":["ApiRepository","RepositoryUri"]}},"WebUri":{"Value":{"Fn::GetAtt":["WebRepository","RepositoryUri"]}},"ResearchUri":{"Value":{"Fn::GetAtt":["ResearchRepository","RepositoryUri"]}}}}
